@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">

    <h1 class="display-4 fw-bold">ABC Retail</h1>

    <p class="lead text-muted mb-4">
        Azure cloud storage management application
    </p>

    <p>
        Manage customer profiles, product information and product images
        using Microsoft Azure Storage Services.
    </p>

    <div class="mt-4">

        <a asp-controller="Customers"
            asp-action="Index"
            class="btn btn-primary btn-lg me-2">
                Customers
            </a>

            <a asp-controller="Products"
            asp-action="Index"
            class="btn btn-success btn-lg me-2">
                Products
            </a>

            <a asp-controller="Orders"
            asp-action="Index"
            class="btn btn-danger btn-lg me-2">
                Orders
            </a>

            <a asp-controller="Logs"
            asp-action="Index"
            class="btn btn-info btn-lg">
                Logs
            </a>

    </div>

</div>