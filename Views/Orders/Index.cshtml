@model IEnumerable<string>

@{
    ViewData["Title"] = "Orders";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Order Processing</h1>

        <p class="text-muted">
            Order and inventory messages stored in Azure Queue Storage.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Process Order
    </a>

</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        No queue messages are currently available.
    </div>
}
else
{
    <div class="row">

        @foreach (var message in Model)
        {
            <div class="col-md-6 mb-3">

                <div class="card">
                    <div class="card-body">

                        <h5 class="card-title">
                            Queue Message
                        </h5>

                        <p class="card-text">
                            @message
                        </p>

                    </div>
                </div>

            </div>
        }

    </div>
}