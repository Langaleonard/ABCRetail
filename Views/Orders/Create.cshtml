@model ABCRetail.Models.OrderMessage

@{
    ViewData["Title"] = "Process Order";
}

<h1>Process Order</h1>

<p class="text-muted">
    Send order processing information to Azure Queue Storage.
</p>

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="OrderId"
                       class="control-label"></label>

                <input asp-for="OrderId"
                       class="form-control"
                       placeholder="ORD001" />

                <span asp-validation-for="OrderId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CustomerName"
                       class="control-label"></label>

                <input asp-for="CustomerName"
                       class="form-control" />

                <span asp-validation-for="CustomerName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProductName"
                       class="control-label"></label>

                <input asp-for="ProductName"
                       class="form-control" />

                <span asp-validation-for="ProductName"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Quantity"
                       class="control-label"></label>

                <input asp-for="Quantity"
                       class="form-control" />

                <span asp-validation-for="Quantity"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status"
                       class="control-label"></label>

                <select asp-for="Status"
                        class="form-select">
                    <option value="Processing">Processing</option>
                    <option value="Packed">Packed</option>
                    <option value="Ready for Dispatch">
                        Ready for Dispatch
                    </option>
                </select>
            </div>

            <button type="submit"
                    class="btn btn-primary">
                Send Order Message
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back to Orders
            </a>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}